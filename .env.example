# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional creator passphrase for uploading Blender .glb models in production builds
SONKO_STUDIO_KEY=""

# Optional Google AdSense / H5 Games Ads public publisher ID (e.g. ca-pub-1234567890123456)
# Leave blank to use the built-in Development Ad Simulator
VITE_ADSENSE_CLIENT_ID=""
# Optional server-side override used for /ads.txt and initial <head> verification tags
ADSENSE_CLIENT_ID=""

# Set to "true" to force the Development Ad Simulator instead of live H5 Games Ads
VITE_AD_SIMULATOR="false"

# Set to "true" to enable Google H5 Games Ads test mode (data-adbreak-test="on")
VITE_ADSENSE_TEST_MODE="false"

# Optional public support email displayed on /privacy-policy, /terms, and /contact
CONTACT_EMAIL=""
